# Copy this file to .env before running docker compose.
# Use a long, randomly generated database password with URL-safe characters.
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_PORT=8000

# Keep false for http://localhost. Set true only after HTTPS is working.
COOKIE_SECURE=false

# Comma-separated origins. For same-origin production, use the public HTTPS URL.
ALLOWED_ORIGINS=http://localhost:8000

